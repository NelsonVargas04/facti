{
  "name": "facti",
  "private": true,
  "version": "0.1.0",
  "description": "Facti: facturación electrónica conectada con ARCA",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20.6" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "arca:probar": "tsx --env-file=.env scripts/probar-conexion.ts",
    "arca:padron": "tsx --env-file=.env scripts/consultar-padron.ts",
    "arca:factura-c": "tsx --env-file=.env scripts/emitir-factura-c.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
