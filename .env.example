# Entorno de ARCA: homologacion (pruebas) o produccion
ARCA_ENTORNO=homologacion

# CUIT dueño del certificado (en producción: el CUIT de la empresa de Facti)
ARCA_CUIT_CERTIFICADO=20111111112

# CUIT del contribuyente que factura (en homologación suele ser el mismo que el del certificado)
ARCA_CUIT_EMISOR=20111111112

# Punto de venta de tipo Web Services del emisor
ARCA_PUNTO_VENTA=1

# Rutas al certificado y la clave privada (nunca subirlos al repo).
# Las rutas relativas se toman desde la raíz del repo (donde está este archivo).
ARCA_CERT_PATH=certs/homologacion.crt
ARCA_KEY_PATH=certs/homologacion.key

# Carpeta donde se guardan los tickets de acceso del WSAA (duran ~12 h)
ARCA_CACHE_DIR=.cache

# Puerto del backend (apps/api, Go). La web (apps/web) usa el 3000.
API_PORT=4000

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# Vacío = cualquiera (solo para desarrollo).
WEB_ORIGIN=http://localhost:3000
