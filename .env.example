# Entorno de ARCA: homologacion (pruebas) o produccion
ARCA_ENTORNO=homologacion

# CUIT dueño del certificado (en producción: el CUIT de la empresa de Facti)
ARCA_CUIT_CERTIFICADO=20111111112

# CUIT para las pruebas manuales (pnpm arca:*). En la app, cada usuario carga su CUIT en el onboarding.
ARCA_CUIT_EMISOR=20111111112

# Punto de venta Web Services con el que arrancan las cuentas nuevas
ARCA_PUNTO_VENTA=1

# Rutas al certificado y la clave privada (nunca subirlos al repo).
# Las rutas relativas se toman desde la raíz del repo (donde está este archivo).
ARCA_CERT_PATH=certs/homologacion.crt
ARCA_KEY_PATH=certs/homologacion.key
# En Vercel no hay archivos: pegá el contenido del certificado y de la clave (el PEM tal cual
# o en base64) en estas dos variables. Si están, tienen prioridad sobre las rutas de arriba.
ARCA_CERT_PEM=
ARCA_KEY_PEM=

# Carpeta donde se guardan los tickets de acceso del WSAA (duran ~12 h)
ARCA_CACHE_DIR=.cache

# Base de datos (Postgres). En Supabase: Project Settings → Database → Connection string → URI.
# Usá el "Session pooler" (puerto 5432) o la conexión directa; el "Transaction pooler" (6543) también
# funciona. Reemplazá [YOUR-PASSWORD] por la contraseña de la base. Nunca la subas al repo.
# Las tablas se crean solas en el esquema "facti" la primera vez que la API se conecta.
DATABASE_URL=

# Inicio de sesión (Supabase Auth, con Google y email). En Supabase: Project Settings → API Keys.
# Las dos son públicas (van al navegador). La web y la API leen la misma URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo si tu proyecto todavía firma las sesiones con el "JWT secret" legado (HS256). Es secreto.
SUPABASE_JWT_SECRET=

# Puerto del backend (apps/api, Go). La web (apps/web) usa el 3000.
API_PORT=4000

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# Vacío = cualquiera (solo para desarrollo).
WEB_ORIGIN=http://localhost:3000

# Modo demo, solo para probar en la compu: cuenta de prueba en memoria, sin Supabase ni base.
# La API lo rechaza con ARCA_ENTORNO=produccion. Dejalo vacío (o borralo) para usar el login real.
FACTI_DEMO=
NEXT_PUBLIC_DEMO=

# CUIT de Facti: el "representante" al que cada usuario le delega la facturación en ARCA
# (el dueño del certificado). Se muestra en el onboarding y en la guía de cómo conectar ARCA.
NEXT_PUBLIC_CUIT_FACTI=
# Modo demo: nombre de la cuenta de prueba (como figura en ARCA). Si ARCA_CUIT_EMISOR es un CUIT real
# con certificado autorizado, la cuenta de prueba emite de verdad en homologación.
FACTI_DEMO_NOMBRE=

# Mercado Pago: cobro de Facti Pro (suscripción mensual). Sin MP_ACCESS_TOKEN, "Plan y pagos" queda en
# vista previa y no se cobra nada. En Mercado Pago Developers → Tus integraciones → tu aplicación →
# Credenciales: para probar, las "de prueba" (empiezan con TEST- o son de un usuario de prueba).
# El access token es SECRETO: va solo acá (y en el gestor de secretos en producción), nunca en el chat ni en el repo.
MP_ACCESS_TOKEN=
# Webhooks → "Clave secreta" de la aplicación. Valida que los avisos vengan de Mercado Pago.
# La URL para cargar en Mercado Pago es https://<tu-api>/webhooks/mercadopago (eventos: Suscripciones / planes).
MP_WEBHOOK_SECRET=
# Precio de Pro en dólares. Se cobra en pesos con el dólar del BCRA del día en que se suscribe.
FACTI_PRECIO_PRO_USD=10
# URL pública de la web, a la que vuelve el usuario después de pagar (si está vacía, el primer WEB_ORIGIN).
# Mercado Pago puede rechazar http://localhost: para probar de punta a punta usá la URL de Vercel.
WEB_URL=

# Facturas recurrentes automáticas: un cron diario llama a GET o POST /recurrentes/procesar con
# "Authorization: Bearer <CRON_SECRET>" (en Vercel, Cron Jobs manda esa cabecera solo). Vacío = no se emiten solas.
CRON_SECRET=
